create table public.tattoo_request (
  id uuid primary key default gen_random_uuid(),

  user_id uuid not null
    references auth.users(id)
    on delete cascade,

  flash_id uuid null
    references public.flash(id)
    on delete set null,  

  client_tattoo_id uuid null
    references public.tattoo(id)
    on delete set null,

  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),

  bluesky_id text null,
  email text not null,
  first_name text null,

  gender text null,
  instagram_id text null,
  last_name text null,
  notes text null,
  of_age boolean null,
  paid_amount numeric(10,2) null default 0,
  phone text not null,
  placement text null,
  preferred_name text not null,
  ref_images jsonb null,
  seen_at timestamptz null,
  size text null,
  type text null,
);